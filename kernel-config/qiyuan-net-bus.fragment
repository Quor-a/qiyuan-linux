# 启元 Linux 内核驱动片段：网络 / 无线 / 蓝牙 / USB / 总线
# 由 recipes/kernel.py 在 defconfig 之后 merge 进来。
# 目标：覆盖主流 PC 有线网卡、WiFi 芯片、蓝牙控制器、USB 全栈与常见总线，
# 使发行版能直接在真机（笔电/台式/迷你机）上联网与外设可用。

## ---------- 有线以太网 ----------
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E100=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGBVF=y
CONFIG_IXGBE=y
CONFIG_IXGBEVF=y
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_R8169=m
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_ATL1=y
CONFIG_ATL1E=y
CONFIG_ATL1C=y
CONFIG_ALX=y
CONFIG_ATLANTIC=m
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_B44=y
CONFIG_BNX2=y
CONFIG_TIGON3=y
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y
CONFIG_NET_VENDOR_VIA=y
CONFIG_VIA_RHINE=y
CONFIG_VIA_VELOCITY=y
CONFIG_NET_VENDOR_SIS=y
CONFIG_SIS900=y
CONFIG_NET_VENDOR_NATSEMI=y
