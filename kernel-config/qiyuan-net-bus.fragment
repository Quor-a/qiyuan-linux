CONFIG_FORCEDETH=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=m

## ---------- WiFi: 框架 ----------
