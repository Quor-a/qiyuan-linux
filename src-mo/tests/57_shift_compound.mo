# <<= >>= 三字符复合赋值（此前只有 += -= *= /= %= &= |= ^=）
# expect: 64
# 48 + 12 + 4；第一版期望值写成 60，漏算了 c 的贡献
fn main() -> i64 {
    let a: i64 = 3;
    a <<= 4;            # 48
    let b: i64 = 100;
    b >>= 3;            # 12
    let c: i64 = 1;
    c <<= 1;
    c <<= 1;            # 4
    return a + b + c;
}
