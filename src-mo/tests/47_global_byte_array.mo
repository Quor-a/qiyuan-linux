# expect: 224
# 全局 byte 数组：一个元素一个字节，且不侵占后面的全局变量
# （(65*100000 + 72*1000) & 255 = 224；若数组没分到空间，会算成 68）
var a: [2] i64 = 0;
var b: [8] byte = 0;
var c: [2] i64 = 0;

fn main() -> i64 {
    let i: i64 = 0;
    while i < 8 {
        b[i] = 65 + i;
        i = i + 1;
    }
    return (b[0] * 100000 + b[7] * 1000 + c[0] * 100 + c[1]) & 255;
}
