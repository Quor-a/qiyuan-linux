# x86_64 基线片段 —— 启元 Linux 桌面/服务器形态
#
# 覆盖 kernel.py REQUIRED 清单的 x86_64 部分 + 发行版基础。
# UEFI 启动、串口控制台、模块化文件系统。

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_IA32_EMULATION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_SECCOMP=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
