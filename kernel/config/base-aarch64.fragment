# aarch64 基线片段 —— 启元 Linux ARM64 形态（含安卓移动形态）
#
# 覆盖 kernel.py REQUIRED 清单的 aarch64 部分 + ARM64 基础。
# 设备树启动（安卓设备的引导方式）、GPIO/中断控制器。

CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_OF=y
# 设备树：ARM64 世界的"BIOS"，安卓 bootloader 以 DTB 传硬件描述
CONFIG_OF_OVERLAY=y
CONFIG_DTC=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_SECCOMP=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
# UEFI 启动（ARM64 服务器/部分开发板走 UEFI；安卓板走设备树）
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# 通用 8250 串口（部分 ARM SoC 用它，配合 earlycon 排障）
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# ARM 系统控制单元与电源管理（手机 SoC 必需）
CONFIG_ARM_SCPI_PROTOCOL=y
CONFIG_ARM_SCPI_POWER_DOMAIN=y
# 通用串口（earlycon 排障命脉）
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# 虚拟化支持（KVM）
CONFIG_KVM=y
